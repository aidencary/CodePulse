              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has overall_score as int 0-100', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.overall_score).to.be.a('number');",
                  "    pm.expect(jsonData.overall_score).to.be.at.least(0);",
                  "    pm.expect(jsonData.overall_score).to.be.at.most(100);",
                  "});",
                  "",
                  "pm.test('Response has summary as string', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.summary).to.be.a('string');",
                  "    pm.expect(jsonData.summary.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Response has findings array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.findings).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each finding has correct schema', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var validSeverities = ['Low', 'Med', 'High'];",
                  "    jsonData.findings.forEach(function (f) {",
                  "        pm.expect(f).to.have.property('issue_type');",
                  "        pm.expect(f).to.have.property('line_number');",
                  "        pm.expect(f).to.have.property('severity');",
                  "        pm.expect(f).to.have.property('message');",
                  "        pm.expect(validSeverities).to.include(f.severity);",
                  "        pm.expect(f.line_number).to.be.a('number');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response has predicted_bugs array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.predicted_bugs).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each predicted bug has correct schema', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var validSeverities = ['low', 'medium', 'high', 'critical'];",
                  "    jsonData.predicted_bugs.forEach(function (b) {",
                  "        pm.expect(b).to.have.property('bug_type');",
                  "        pm.expect(b).to.have.property('severity');",
                  "        pm.expect(b).to.have.property('description');",
                  "        pm.expect(b).to.have.property('suggested_fix');",
                  "        pm.expect(validSeverities).to.include(b.severity);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response time is under 15s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ]

  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: security headers on every response",
          "pm.test('Security header: X-Content-Type-Options', function () {",
          "    pm.response.to.have.header('X-Content-Type-Options');",
          "});",
          "",
          "pm.test('Security header: X-Frame-Options', function () {",
          "    pm.response.to.have.header('X-Frame-Options');",
          "});"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('Environment: ' + pm.environment.get('base_url'));",
          "",
          "// Auto-generate a valid HS256 JWT if auth_token is empty.",
          "// Uses jwt_secret and supabase_url from the environment.",
          "(function () {",
          "    var token = pm.environment.get('auth_token');",
          "    if (token && token.length > 0) return; // already set",
          "",
          "    var secret = pm.environment.get('jwt_secret');",
          "    var supabaseUrl = pm.environment.get('supabase_url');",
          "    if (!secret || !supabaseUrl) {",
          "        console.warn('No auth_token, jwt_secret, or supabase_url — authenticated requests will fail.');",
          "        return;",
          "    }",
          "",
          "    // Base64url encode helper",
          "    function base64url(source) {",
          "        var encoded = CryptoJS.enc.Base64.stringify(source);",
          "        return encoded.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "    }",
          "",
          "    var header = { alg: 'HS256', typ: 'JWT' };",
          "    var now = Math.floor(Date.now() / 1000);",
          "    var payload = {",
          "        sub: 'ci-test-user',",
          "        aud: 'authenticated',",
          "        iss: supabaseUrl + '/auth/v1',",
          "        exp: now + 3600",
          "    };",
          "",
          "    var headerB64 = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "    var payloadB64 = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "    var signature = base64url(CryptoJS.HmacSHA256(headerB64 + '.' + payloadB64, secret));",
          "",
          "    var jwt = headerB64 + '.' + payloadB64 + '.' + signature;",
          "    pm.environment.set('auth_token', jwt);",
          "    console.log('Auto-generated auth_token for this session.');",
          "})();"
        ]
      }
    }
  ],

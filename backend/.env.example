# ============================================================
# CodePulse Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Supabase (from: Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Direct DB connection (from: Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[your-db-password]@db.your-project-ref.supabase.co:5432/postgres
